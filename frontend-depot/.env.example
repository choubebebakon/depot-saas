# API backend
VITE_API_URL=http://localhost:3000

# Google Identity Services — OAuth 2.0 Web Client ID
# Must be the same client ID configured as GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Apple Sign-In — Service ID configured in Apple Developer
# Must match APPLE_CLIENT_ID and the configured Return URL on the backend.
VITE_APPLE_CLIENT_ID=com.example.gestock.web
VITE_APPLE_REDIRECT_URI=https://api.example.com/auth/apple/callback
