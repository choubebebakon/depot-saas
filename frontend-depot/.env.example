# API backend
VITE_API_URL=http://localhost:3000

# Temps réel (WebSocket Socket.IO — namespace /realtime)
# En production : URL racine du backend (ex: https://api.example.com).
# Si absente, l'origine est déduite de VITE_API_URL, sinon de l'URL courante.
VITE_REALTIME_URL=http://localhost:3000

# Google Identity Services — OAuth 2.0 Web Client ID
# Must be the same client ID configured as GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Apple Sign-In — Service ID configured in Apple Developer
# Must match APPLE_CLIENT_ID and the configured Return URL on the backend.
VITE_APPLE_CLIENT_ID=com.example.gestock.web
VITE_APPLE_REDIRECT_URI=https://api.example.com/auth/apple/callback

# Intégration Meta native (WhatsApp / Instagram / Messenger) — valeurs PUBLIQUES.
# VITE_META_APP_ID : ID de l'app Meta (Meta App Dashboard > Settings > Basic).
# VITE_META_CONFIG_ID : ID du template de configuration Embedded Signup
# (Meta App Dashboard > WhatsApp > Configuration). Détermine aussi la durée
# de vie du token généré (60 jours ou « never » — à confirmer dans le dashboard).
VITE_META_APP_ID=your_meta_app_id
VITE_META_CONFIG_ID=your_embedded_signup_config_id
