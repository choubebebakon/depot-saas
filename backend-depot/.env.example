# ─── Base de données ────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/db   # PostgreSQL URL

# ─── JWT ────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_in_prod                # Access Token (15min)
JWT_REFRESH_SECRET=change_me_in_prod               # Refresh Token (30j)

# ─── Google Sign-In ─────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console.
# Must match the VITE_GOOGLE_CLIENT_ID used by the frontend.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ─── Apple Sign-In ──────────────────────────────
# Service ID configured in Apple Developer for the web application.
APPLE_CLIENT_ID=com.example.gestock.web
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
# Keep the private key secret. In environment variables, encode line breaks as \n.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----"
# Must exactly match the Return URL configured in Apple Developer.
# For Apple JS popup this should be a real HTTPS frontend URL, e.g. https://app.example.com/login.
APPLE_REDIRECT_URI=https://app.example.com/login

# ─── MTN MoMo via Campay ────────────────────────
# ⚠️ DÉCOMMISSIONNEMENT (PARTIE 1, phase 2) : ces 3 variables sont à RETIRER
# après la période de grâce webhook (paiements Campay en vol — voir
# docs/PAYMENTS_NOTCHPAY_MIGRATION.md). Ne pas retirer avant la vérification
# « zéro PENDING Campay/MTN en cours ».
CAMPAY_APP_USERNAME=your_campay_username           # Identifiant Campay
CAMPAY_APP_PASSWORD=your_campay_password           # Mot de passe Campay
CAMPAY_WEBHOOK_SECRET=your_webhook_secret          # Signature webhook Campay

# ─── Stripe (Carte Visa/MasterCard) ─────────────
# ⚠️ DÉCOMMISSIONNEMENT (PARTIE 1, phase 3) : STRIPE_SECRET_KEY et
# STRIPE_WEBHOOK_SECRET sont à RETIRER après la période de grâce webhook.
# STRIPE_PUBLISHABLE_KEY est déjà inutilisé : le flux Stripe Elements
# (page /payment-card + stripeClientSecret) n'a jamais été câblé côté
# backend — les cartes passent désormais par NotchPay (channel 'card').
STRIPE_SECRET_KEY=sk_live_xxx                      # Clé secrète Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_xxx                 # Clé publique (frontend)
STRIPE_WEBHOOK_SECRET=whsec_xxx                    # Signature webhook Stripe

# ─── NotchPay (AGREGATEUR UNIQUE — faits validés en LIVE GesTock) ─────
# FAIT VALIDÉ n°1 : les endpoints de paiement standard s'authentifient avec
# la CLÉ PUBLIQUE dans `Authorization` (la clé privée dans Authorization
# provoque le 401 "Invalid API credentials" — constaté en production).
# La clé privée ne sert que le header `X-Grant` des endpoints à risque
# (transferts). Format des clés : contient un point littéral (pk. / sk. /
# hsk.) — toute regex de validation doit inclure '.' (FAIT VALIDÉ n°2).
# ⚠️ NE JAMAIS exposer NOTCHPAY_PRIVATE_KEY / NOTCHPAY_HASH_KEY au frontend.
# Seule la clé publique transite côté client (SDK inline).
# FAIT VALIDÉ n°7 : le secret de signature webhook est celui affiché À LA
# CRÉATION DE L'ENDPOINT webhook (contexte "Votre compte", pas "Événements
# de facturation" — FAIT VALIDÉ n°8) ; vérifier qu'il correspond bien à
# NOTCHPAY_HASH_KEY au moment de la configuration.
NOTCHPAY_PUBLIC_KEY=pk.xxxx
NOTCHPAY_PRIVATE_KEY=sk.xxxx
NOTCHPAY_HASH_KEY=hsk.xxxx
NOTCHPAY_ENDPOINT=https://api.notchpay.co
# FAIT VALIDÉ (OpenAPI 2.1.0 + test LIVE) : POST /payments répond
#   authorization_url (URL de la page de paiement HÉBERGÉE — c'est ce champ que
#   le backend transmet au frontend pour la redirection) et
#   transaction.reference (identifiant trx.… utilisé pour rapprocher les
#   webhooks). `checkout_url` N'EXISTE PAS dans la réponse.
# Il n'existe AUCUN SDK JavaScript navigateur : ne jamais réintroduire de
# <script src="https://checkout.notchpay.co/..."> (hôte inexistant →
# ERR_CONNECTION_RESET constaté en production).
#
# Optionnel — URL de retour après paiement (callback NotchPay). Si définie,
# NotchPay redirige le client vers cette URL avec
# ?reference=trx.…&status=…&trxref=<notre référence>. Laisser vide pour
# conserver la page de résultat NotchPay. Exemple :
#   NOTCHPAY_CALLBACK_URL=https://app.gestock.cm/paiement/retour
# ⚠️ L'activation de l'abonnement NE dépend PAS de ce retour : elle est
# déclenchée uniquement par le webhook signé côté serveur.
# NOTCHPAY_CALLBACK_URL=
#
# Verrouillage du canal sur la page hébergée (locked_channel).
# DÉFAUT : false — NE PAS ACTIVER sans raison.
# MESURÉ EN RÉEL (sonde sur le compte LIVE) : envoyer `locked_channel`
# ('cm.mtn' OU 'cm.orange', avec ou sans `phone`) fait afficher à la page
# NotchPay « Méthode de paiement indisponible », alors que la même page SANS
# verrou liste correctement MTN MoMo et Orange Money (CM). Le verrou est donc
# bien pris en compte par l'agrégateur, mais ce parcours n'est pas
# opérationnel sur ce compte — à clarifier avec le support NotchPay.
# Avec false (recommandé), la page propose les canaux réellement actifs du
# compte et le commerçant y choisit sa méthode.
NOTCHPAY_LOCK_CHANNEL=false
# FAIT VALIDÉ n°9 : si le serveur (Windows constaté en dev, Node 18+) échoue
# à résoudre api.notchpay.co (getaddrinfo ENOTFOUND alors que le DNS
# fonctionne ailleurs), démarrer avec :
#   NODE_OPTIONS=--dns-result-order=ipv4first
# À vérifier sur le serveur de production AVANT d'ajouter ce flag partout.
# COUVERTURE RÉELLE (GET /channels, FAIT VALIDÉ n°6) : canaux actifs sur le
# compte = cm.mtn + cm.orange uniquement (CM, XAF, max 500 000 XAF/txn) ;
# le canal 'card' est INACTIF — tant qu'il n'est pas activé côté NotchPay,
# les paiements carte sont refusés fail-closed.

# ─── Monitoring ─────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx               # DSN projet Sentry

# ─── Notifications : Email (SMTP) ─────────────────────────────────────────
# Optionnel. Si SMTP_HOST ou SMTP_USER est absent, EmailChannel reste en mode
# dégradé : un WARN « SMTP non configuré — emails désactivés » est émis au
# démarrage et les notifications in-app continuent de fonctionner (les emails
# ne sont simplement pas envoyés).
SMTP_HOST=smtp.example.com
SMTP_PORT=587                                      # 587 (STARTTLS) ou 465 (SSL)
SMTP_USER=noreply@example.com
SMTP_PASS=change_me_smtp_password
SMTP_FROM=noreply@gestock.cm                       # Expéditeur affiché (défaut : noreply@gestock.cm)

# ─── Notifications : Push (Firebase Cloud Messaging) ──────────────────────
# Optionnel. Si les 3 variables sont absentes, PushChannel reste en mode
# dégradé : un WARN « Firebase non configuré — Push désactivé (mode dégradé) »
# est émis au démarrage. Valeurs issues du fichier JSON de compte de service
# Firebase (Project settings > Service accounts > Generate new private key).
# ⚠️ FIREBASE_PRIVATE_KEY contient des sauts de ligne : les encoder en \n.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# ─── App ────────────────────────────────────────
NODE_ENV=development                               # development | production
APP_PORT=3000                                      # Port du serveur NestJS
FRONTEND_URL=http://localhost:5174                 # URL frontend (CORS)

# ─── CRM omnicanal (WhatsApp Business / Instagram DM / Messenger) ──────
# Secret serveur qui sale l'empreinte HMAC-SHA256 des clés d'API CRM.
# 32 octets aléatoires minimum (openssl rand -hex 32). OBLIGATOIRE en
# production : sans lui, les routes /api/v1/crm refusent de servir (fail
# closed) au lieu de comparer des empreintes calculées à vide.
# En développement, un secret éphémère est généré à chaque démarrage : les
# clés créées lors d'un démarrage précédent ne sont alors plus résolues.
CRM_API_KEY_PEPPER=change_me_with_openssl_rand_hex_32

# Secret App Meta (Meta App Dashboard > Settings > Basic > App Secret).
# Sert à vérifier X-Hub-Signature-256 sur le corps brut des webhooks.
META_APP_SECRET=change_me_meta_app_secret

# Politique de vérification de la signature Meta sur les routes CRM :
#   off      : aucune vérification (l'appelant est un orchestrateur interne
#              authentifié uniquement par x-api-key)
#   optional : vérifiée dès que l'en-tête est présent (défaut prudent)
#   required : obligatoire — à utiliser si la route est exposée DIRECTEMENT
#              aux webhooks Meta
META_WEBHOOK_SIGNATURE_MODE=optional

# Sel utilisé pour pseudonymiser les identifiants de canal (téléphone,
# identifiant Instagram/Messenger) dans les logs. Sans lui,
# CRM_API_KEY_PEPPER est réutilisé. Aucune PII n'est jamais journalisée en
# clair, même si cette variable est absente.
CRM_LOG_SUBJECT_SALT=change_me_log_subject_salt
   
# WhatsApp Cloud API (notifications globales GesTock — indépendantes des
# tokens PAR COMMERÇANT gérés par le module Meta natif / MetaIntegration).
WHATSAPP_TOKEN=
# ID du numéro expéditeur (Meta > WhatsApp > API Setup > Phone number ID).
# Anciennement lu « WHATSAPP_PHONE_ID » par le code : les deux noms sont
# désormais acceptés, mais WHATSAPP_PHONE_NUMBER_ID est la forme officielle.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optionnel : surcharge l'URL Graph du canal de notification. Par défaut
# https://graph.facebook.com/${META_GRAPH_VERSION} (v21.0).
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ─── Intégration Meta native (WhatsApp Cloud API / Instagram / Messenger) ─────
# ID de l'application Meta (Meta App Dashboard > Settings > Basic > App ID).
# Public : peut être exposé au frontend (VITE_META_APP_ID côté frontend-depot).
META_APP_ID=your_meta_app_id

# Secret App Meta (Meta App Dashboard > Settings > Basic > App Secret).
# Sert à vérifier X-Hub-Signature-256 sur le corps BRUT des webhooks et à
# calculer l'app access token de /debug_token. JAMAIS exposé au frontend.
META_APP_SECRET=your_meta_app_secret

# Token de vérification du handshake webhook Meta (GET /meta/webhook).
# Valeur libre choisie par vous, à recopier dans Meta App Dashboard >
# WhatsApp > Configuration > Webhook > Verify token.
META_WEBHOOK_VERIFY_TOKEN=change_me_verify_token

# Clé de chiffrement AES-256-GCM des jetons Meta : 64 caractères hexadécimaux
# (32 octets) — openssl rand -hex 32. OBLIGATOIRE en production (fail closed :
# le backend refuse de démarrer sans elle). En dev, une clé éphémère est
# générée à chaque démarrage ; les tokens chiffrés au démarrage précédent
# deviennent alors illisibles (volontaire, journalisé).
META_TOKEN_ENCRYPTION_KEY=change_me_with_openssl_rand_hex_32

# Version de la Graph API (défaut v21.0). À aligner sur la version réellement
# configurée pour Embedded Signup v4 dans le dashboard Meta du projet.
META_GRAPH_VERSION=v21.0

# ID de configuration Embedded Signup (Meta App Dashboard > WhatsApp >
# Configuration > Embedded signup > Template de configuration). ⚠️ Le template
# détermine la DURÉE DE VIE du token (60 jours ou « never ») : à CONFIRMER
# avant de coder une rotation à date fixe (voir docs/META_NATIVE_INTEGRATION.md).
META_CONFIG_ID=